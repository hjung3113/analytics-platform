{
  "name": "@fops/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./global-screens": "./src/global-screens/index.ts",
    "./global-screens/core": "./src/global-screens/core.ts",
    "./operator-screens/scope-picker": "./src/operator-screens/scope-picker/index.ts",
    "./operator-screens/dashboard": "./src/operator-screens/dashboard/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "gen:routes": "node ../../scripts/generate-routes.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "pnpm run gen:routes && vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test -c playwright.config.ts",
    "test:visual:update": "playwright test -c playwright.config.ts --update-snapshots",
    "typecheck": "pnpm run gen:routes && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ap/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fops/shared": "workspace:*",
    "@fops/ui": "workspace:*",
    "@hookform/resolvers": "3.9.1",
    "@tanstack/react-query": "5.62.7",
    "@tanstack/react-router": "1.170.1",
    "cmdk": "^1.1.1",
    "lucide-react": "0.469.0",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.54.2",
    "sonner": "^2.0.7",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  }
}
