{
  "name": "feedbackops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "build": "turbo run build --filter='@fops/*'",
    "dev": "turbo run dev --filter='@fops/*'",
    "gen:routes": "node scripts/generate-routes.mjs",
    "test": "turbo run test --filter='@fops/*'",
    "lint": "biome check .",
    "lint:design": "oxlint --max-warnings 0 apps/frontend/src packages/ui/src",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck --filter='@fops/*'",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "gate:db-migration-drift": "node scripts/gates/db-migration-drift-gate.mjs",
    "gate:fe-typecheck": "node scripts/gates/fe-typecheck-gate.mjs",
    "gate:fe-lint": "node scripts/gates/fe-biome-gate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@shadcn/lint": "0.2.0",
    "oxlint": "1.86.0",
    "typescript": "5.7.2"
  }
}
