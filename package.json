{
  "name": "analytics-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ap/platform-web",
    "gen:menu": "node tooling/gen-menu/src/cli.ts",
    "lint": "turbo run lint --filter='!@fops/*' --only",
    "typecheck": "turbo run typecheck --filter='!@fops/*' --only",
    "test": "turbo run test --filter='!@fops/*' --only",
    "build": "turbo run build --filter='!@fops/*' --only",
    "e2e": "pnpm --filter @ap/platform-e2e e2e"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  }
}
