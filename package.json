{
  "name": "analytics-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ap/platform-web",
    "docs:links": "node .github/scripts/check-doc-links.mjs",
    "sdk:pack": "node tooling/scripts/sdk-pack.mjs",
    "sdk:consumer-check": "node tooling/scripts/sdk-consumer-check.mjs",
    "sdk:api": "node tooling/scripts/sdk-api-snapshot.mjs",
    "check:lazy-chunks": "node tooling/scripts/check-lazy-chunks.mjs",
    "gen:menu": "node tooling/gen-menu/src/cli.ts",
    "lint": "turbo run lint --filter='!@fops/*' --filter='!feedbackops'",
    "typecheck": "turbo run typecheck --filter='!@fops/*' --filter='!feedbackops'",
    "test": "turbo run test --filter='!@fops/*' --filter='!feedbackops'",
    "build": "turbo run build --filter='!@fops/*' --filter='!feedbackops'",
    "e2e": "pnpm --filter @ap/platform-e2e e2e",
    "e2e:base-path": "pnpm --filter @ap/platform-e2e e2e:base-path",
    "sdk:test": "node --test tooling/scripts/*.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  }
}
