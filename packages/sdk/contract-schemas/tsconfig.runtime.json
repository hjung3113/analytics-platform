{
  // Emitted JavaScript + declarations of src/ for Node consumers (the core server, ADR-0097). The sources keep their `.ts`
  // specifiers; `rewriteRelativeImportExtensions` turns them into `.js` in the output, so no source edit and no second copy.
  "extends": "@ap/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
