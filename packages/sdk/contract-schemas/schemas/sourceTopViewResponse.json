{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?:\\/\\/\\S+$"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "url",
        "synthetic"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "unsupported"
        },
        "reason": {
          "type": "string",
          "enum": [
            "parser_not_connected",
            "periods_not_supported",
            "top_view_not_connected",
            "capability_missing"
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "permission_denied"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "source_absent"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  ]
}
