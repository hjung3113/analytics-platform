{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attemptNo": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "attemptNo"
  ],
  "additionalProperties": false
}
