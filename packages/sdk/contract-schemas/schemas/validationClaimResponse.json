{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "roundId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "immediate": {
          "type": "boolean"
        },
        "engineProfileRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attemptNo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "sampleSet": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fileRef": {
                    "type": "string"
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "fileRef",
                  "order",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "sourceOwner": {
              "type": "string"
            }
          },
          "required": [
            "files",
            "sourceOwner"
          ],
          "additionalProperties": false
        },
        "sampleManifestDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "specPin": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "roundId",
        "priority",
        "immediate",
        "engineProfileRef",
        "requestDigest",
        "attemptNo",
        "maxAttempts",
        "sampleSet",
        "sampleManifestDigest",
        "specPin"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "attemptNo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "id",
        "attemptNo"
      ],
      "additionalProperties": false
    },
    "leaseExpiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
    }
  },
  "required": [
    "request",
    "attempt",
    "leaseExpiresAt"
  ],
  "additionalProperties": false
}
