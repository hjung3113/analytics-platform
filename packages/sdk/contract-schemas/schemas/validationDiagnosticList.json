{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "access": {
      "type": "string",
      "enum": [
        "granted",
        "no_permission"
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "producer": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "producerVersion": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "itemCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
          }
        },
        "required": [
          "producer",
          "producerVersion",
          "schemaVersion",
          "itemCount",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "rows": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "producer": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "itemKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,200}$"
          },
          "origin": {
            "type": "string",
            "enum": [
              "rule",
              "analysis"
            ]
          },
          "ruleResultId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "bodyState": {
            "type": "string",
            "enum": [
              "live",
              "erased_retention",
              "erased_admin"
            ]
          },
          "evidenceCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "tableCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "rowCounts": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            }
          },
          "title": {
            "anyOf": [
              {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "producer",
          "itemKey",
          "origin",
          "ruleResultId",
          "bodyState",
          "evidenceCount",
          "tableCount",
          "rowCounts",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "access",
    "documents",
    "rows",
    "total"
  ],
  "additionalProperties": false
}
