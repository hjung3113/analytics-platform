{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        },
        "extractedFields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 100
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "parserIn": {
          "type": "string",
          "maxLength": 8000
        },
        "parserOut": {
          "type": "string",
          "maxLength": 8000
        },
        "truncated": {
          "type": "boolean"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "extractedFields",
        "parserIn",
        "parserOut",
        "truncated",
        "synthetic"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "unsupported"
        },
        "reason": {
          "type": "string",
          "enum": [
            "parser_not_connected",
            "periods_not_supported",
            "top_view_not_connected",
            "capability_missing"
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "permission_denied"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "source_absent"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  ]
}
