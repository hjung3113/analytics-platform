{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fileRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "line": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fileSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "fileRef",
    "line",
    "fileSha256"
  ],
  "additionalProperties": false
}
