{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceOwner": {
      "maxLength": 200,
      "type": "string",
      "minLength": 1
    },
    "files": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fileRef": {
            "maxLength": 1024,
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "fileRef",
          "order",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sourceOwner",
    "files"
  ],
  "additionalProperties": false
}
