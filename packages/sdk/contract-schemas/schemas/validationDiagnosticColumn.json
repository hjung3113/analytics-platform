{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    },
    "label": {
      "minLength": 1,
      "maxLength": 80,
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "boolean"
      ]
    }
  },
  "required": [
    "key",
    "label",
    "type"
  ],
  "additionalProperties": false
}
