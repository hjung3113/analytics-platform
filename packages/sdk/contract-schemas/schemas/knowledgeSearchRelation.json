{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "predicate": {
      "type": "string",
      "enum": [
        "before",
        "after"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    }
  },
  "required": [
    "source",
    "predicate",
    "target"
  ],
  "additionalProperties": false
}
