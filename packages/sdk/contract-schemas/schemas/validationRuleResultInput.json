{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ruleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "WARN",
        "NOT_CHECKED",
        "SKIPPED",
        "NOT_APPLICABLE",
        "ERROR"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "expected": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "observed": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "anyOf": [
        {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fileRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "fileSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "excerpt": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "fileRef",
              "line",
              "fileSha256"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "ruleId",
    "result",
    "required"
  ],
  "additionalProperties": false
}
