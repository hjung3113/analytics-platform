{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "empty",
        "error",
        "forbidden",
        "too_large",
        "timeout"
      ]
    },
    "data": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "collection",
              "processing_delay",
              "coverage",
              "time_domain",
              "respondent_history"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "confirmed",
              "clear",
              "unknown"
            ]
          },
          "statusSource": {
            "type": "string"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
          },
          "reason": {
            "type": "string",
            "enum": [
              "source_unavailable",
              "check_failed"
            ]
          },
          "explainsEmpty": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "trust": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
            },
            "dataThrough": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "coverage": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "metricVersion": {
              "type": "string"
            },
            "sourceLogicVersions": {
              "uniqueItems": true,
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "provisional": {
              "type": "boolean"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "updatedAt",
            "dataThrough",
            "coverage",
            "provisional",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "recovery": {
      "type": "object",
      "properties": {
        "affectedEquipmentIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
          }
        },
        "authorizedEquipmentIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
          }
        },
        "maxHours": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "retryable": {
          "type": "boolean"
        },
        "deniedScope": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "site"
                },
                "site": {
                  "type": "string",
                  "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
                }
              },
              "required": [
                "kind",
                "site"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "site_room"
                },
                "site": {
                  "type": "string",
                  "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
                },
                "room": {
                  "type": "string",
                  "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
                }
              },
              "required": [
                "kind",
                "site",
                "room"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "outcome",
    "data",
    "assessments",
    "trust",
    "correlationId"
  ],
  "additionalProperties": false
}
