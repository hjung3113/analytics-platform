{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fileRef": {
      "maxLength": 1024,
      "type": "string",
      "minLength": 1
    },
    "fileOrder": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "line": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "text": {
      "type": "string",
      "maxLength": 8000
    },
    "truncated": {
      "type": "boolean"
    },
    "timestamp": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "timeReversal": {
      "type": "boolean"
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "fileRef",
    "fileOrder",
    "line",
    "text",
    "truncated",
    "timestamp",
    "timeReversal",
    "synthetic"
  ],
  "additionalProperties": false
}
