{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "item": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "itemKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,200}$"
        },
        "origin": {
          "type": "string",
          "enum": [
            "rule",
            "analysis"
          ]
        },
        "ruleResultId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bodyState": {
          "type": "string",
          "enum": [
            "live",
            "erased_retention",
            "erased_admin"
          ]
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "anyOf": [
            {
              "minLength": 0,
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceRefs": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fileRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "fileSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "fileRef",
              "line",
              "fileSha256"
            ],
            "additionalProperties": false
          }
        },
        "tables": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tableKey": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,32}$"
              },
              "title": {
                "anyOf": [
                  {
                    "minLength": 0,
                    "maxLength": 200,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "columns": {
                "minItems": 1,
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]{1,32}$"
                    },
                    "label": {
                      "anyOf": [
                        {
                          "minLength": 1,
                          "maxLength": 80,
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "totalRows": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "rowOffset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "rows": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]{1,32}$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "minLength": 0,
                        "maxLength": 500,
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "required": [
              "tableKey",
              "title",
              "columns",
              "totalRows",
              "rowOffset",
              "rows"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "producer",
        "itemKey",
        "origin",
        "ruleResultId",
        "bodyState",
        "title",
        "explanation",
        "evidenceRefs",
        "tables"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "item"
  ],
  "additionalProperties": false
}
