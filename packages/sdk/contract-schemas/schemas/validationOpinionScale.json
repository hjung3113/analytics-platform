{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "grades": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "label": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "key",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "marks": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "label": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "key",
          "label"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "grades",
    "marks"
  ],
  "additionalProperties": false
}
