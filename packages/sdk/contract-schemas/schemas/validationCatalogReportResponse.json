{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reportId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "outcome": {
      "type": "string",
      "const": "accepted"
    },
    "replayed": {
      "type": "boolean"
    },
    "current": {
      "type": "boolean"
    }
  },
  "required": [
    "reportId",
    "outcome",
    "replayed",
    "current"
  ],
  "additionalProperties": false
}
