{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "attemptNo": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "recorded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duplicate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "requestId",
    "attemptNo",
    "recorded",
    "duplicate"
  ],
  "additionalProperties": false
}
