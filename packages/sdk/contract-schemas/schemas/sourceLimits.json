{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "maxRows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "maxRowChars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8000
    },
    "maxWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "timeBudgetMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "required": [
    "maxRows",
    "maxRowChars",
    "maxWindow",
    "timeBudgetMs"
  ],
  "additionalProperties": false
}
