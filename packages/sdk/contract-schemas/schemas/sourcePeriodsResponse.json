{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        },
        "rows": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fileRef": {
                "maxLength": 1024,
                "type": "string",
                "minLength": 1
              },
              "startLine": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "endLine": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "incomplete": {
                "type": "boolean"
              },
              "synthetic": {
                "type": "boolean"
              }
            },
            "required": [
              "fileRef",
              "startLine",
              "endLine",
              "state",
              "incomplete",
              "synthetic"
            ],
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "rows",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "unsupported"
        },
        "reason": {
          "type": "string",
          "enum": [
            "parser_not_connected",
            "periods_not_supported",
            "top_view_not_connected",
            "capability_missing"
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "permission_denied"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "source_absent"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  ]
}
