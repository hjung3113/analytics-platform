{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "limits": {
      "type": "object",
      "properties": {
        "dailyBodyBytes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "dailyExports": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "dailyBodyBytes",
        "dailyExports"
      ],
      "additionalProperties": false
    },
    "rows": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "token",
              "actor",
              "session"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "day": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "readBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "exportBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reads": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "exports": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "atLimit": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "id",
          "day",
          "bytes",
          "readBytes",
          "exportBytes",
          "reads",
          "exports",
          "atLimit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "day",
    "limits",
    "rows"
  ],
  "additionalProperties": false
}
