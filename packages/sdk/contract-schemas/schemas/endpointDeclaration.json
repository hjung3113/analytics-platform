{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "menuId": {
      "type": "string"
    },
    "paramKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permission": {
      "type": "string"
    },
    "requiresScope": {
      "type": "boolean"
    },
    "context": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "enum": [
            "apply",
            "reference"
          ]
        },
        "roomNames": {
          "type": "string",
          "enum": [
            "apply",
            "reference"
          ]
        },
        "line": {
          "type": "string",
          "enum": [
            "apply",
            "reference"
          ]
        },
        "prcGroup": {
          "type": "string",
          "enum": [
            "apply",
            "reference"
          ]
        },
        "condition": {
          "type": "string",
          "enum": [
            "apply",
            "reference"
          ]
        },
        "selection": {
          "type": "string",
          "enum": [
            "apply",
            "reference"
          ]
        },
        "lot": {
          "type": "string",
          "enum": [
            "apply",
            "reference"
          ]
        },
        "ppid": {
          "type": "string",
          "enum": [
            "apply",
            "reference"
          ]
        },
        "recipe": {
          "type": "string",
          "enum": [
            "apply",
            "reference"
          ]
        },
        "metric": {
          "type": "string",
          "enum": [
            "apply",
            "reference"
          ]
        }
      },
      "additionalProperties": false
    },
    "requiredContext": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "time",
          "roomNames",
          "line",
          "prcGroup",
          "condition",
          "selection",
          "lot",
          "ppid",
          "recipe",
          "metric"
        ]
      }
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "collection",
          "processing_delay",
          "coverage",
          "time_domain",
          "respondent_history"
        ]
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxHours": {
          "type": "number"
        },
        "maxRows": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "mergeTimeDomain": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "menuId",
    "paramKeys",
    "permission",
    "requiresScope",
    "context",
    "kinds",
    "mergeTimeDomain"
  ],
  "additionalProperties": false
}
