{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceSystem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$"
    },
    "validatorVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$"
    },
    "ruleSets": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleSetKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$"
          },
          "resultRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "retired"
            ]
          },
          "supersedes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$"
          },
          "rules": {
            "maxItems": 5000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ruleKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "support": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "partial",
                    "unsupported",
                    "unknown"
                  ]
                },
                "scope": {
                  "type": "object",
                  "properties": {
                    "logTypes": {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "processes": {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "modelIds": {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "softwareRange": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "inputFormats": {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "requiredDefault": {
                  "type": "boolean"
                },
                "targets": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "format": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "requirementIds": {
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      }
                    },
                    "required": [
                      "format",
                      "target"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "ruleKey",
                "title",
                "summary",
                "support"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ruleSetKey",
          "revision",
          "status",
          "rules"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sourceSystem",
    "validatorVersion",
    "ruleSets"
  ],
  "additionalProperties": false
}
