{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceOwner": {
      "maxLength": 200,
      "type": "string",
      "minLength": 1
    },
    "fileRef": {
      "maxLength": 1024,
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "sourceOwner",
    "fileRef",
    "line",
    "before",
    "after"
  ],
  "additionalProperties": false
}
