{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tableKey": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    },
    "title": {
      "minLength": 0,
      "maxLength": 200,
      "type": "string"
    },
    "columns": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,32}$"
          },
          "label": {
            "minLength": 1,
            "maxLength": 80,
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "required": [
          "key",
          "label",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "rows": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,32}$"
        },
        "additionalProperties": {
          "anyOf": [
            {
              "minLength": 0,
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "required": [
    "tableKey",
    "columns",
    "rows"
  ],
  "additionalProperties": false
}
