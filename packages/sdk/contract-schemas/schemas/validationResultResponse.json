{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "attemptNo": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "state": {
      "type": "string",
      "const": "succeeded"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "incomplete"
      ]
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ruleCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "requestId",
    "attemptNo",
    "state",
    "verdict",
    "resultDigest",
    "ruleCount"
  ],
  "additionalProperties": false
}
