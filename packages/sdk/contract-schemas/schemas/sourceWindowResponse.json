{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        },
        "rows": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fileRef": {
                "maxLength": 1024,
                "type": "string",
                "minLength": 1
              },
              "fileOrder": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "string",
                "maxLength": 8000
              },
              "truncated": {
                "type": "boolean"
              },
              "timestamp": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timeReversal": {
                "type": "boolean"
              },
              "synthetic": {
                "type": "boolean"
              }
            },
            "required": [
              "fileRef",
              "fileOrder",
              "line",
              "text",
              "truncated",
              "timestamp",
              "timeReversal",
              "synthetic"
            ],
            "additionalProperties": false
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "rows",
        "truncated"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "unsupported"
        },
        "reason": {
          "type": "string",
          "enum": [
            "parser_not_connected",
            "periods_not_supported",
            "top_view_not_connected",
            "capability_missing"
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "permission_denied"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "source_absent"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  ]
}
