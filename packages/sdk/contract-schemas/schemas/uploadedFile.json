{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 33554432
    },
    "mimeType": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "name",
    "size",
    "mimeType"
  ],
  "additionalProperties": false
}
