  "anyOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^:]+$"
        },
        "op": {
          "type": "string",
          "enum": [
            "contains",
            "notContains",
            "startsWith",
            "endsWith",
            "equals",
            "notEquals"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "op",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^:]+$"
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "op",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^:]+$"
        },
        "op": {
          "type": "string",
          "const": "between"
        },
        "value": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": false
        }
      },
      "required": [
        "id",
        "op",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^:]+$"
        },
        "op": {
          "type": "string",
          "const": "between"
        },
        "value": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "op",
        "value"
      ],
      "additionalProperties": false
    },
    {
