{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "v0"
    },
    "suggestions": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "title",
              "eventKey"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "suggestions"
  ],
  "additionalProperties": false
}
