    "menuId": {
      "source": "^[^\\s?#&/=\\p{C}]{1,80}$",
      "flags": "u"
    },
    "filterText": {
      "source": "^[^?#&\\s]{1,80}(?![\\s\\S])",
      "flags": ""
    }
  }
