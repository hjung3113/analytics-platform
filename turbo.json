{
  "$schema": "./node_modules/turbo/schema.json",
  "concurrency": "2",
  "globalPassThroughEnv": ["VITEST_MAX_WORKERS", "VITEST_MAX_FORKS", "VITEST_MAX_THREADS", "VITEST_MIN_FORKS", "VITEST_MIN_THREADS"],
  "tasks": {
    "transit": { "dependsOn": ["^transit"] },
    "typecheck": { "dependsOn": ["transit"] },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/components.json", "$TURBO_ROOT$/apps/platform-web/src/style.css", "$TURBO_ROOT$/tooling/eslint/src/**"],
      "outputs": []
    },
    "test": { "dependsOn": ["transit"] },
    "build": {
      "dependsOn": ["transit", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tooling/scripts/sdk-finalize-dist.mjs"],
      "outputs": ["dist/**"]
    },
    "dev": { "cache": false, "persistent": true }
  }
}
