{
  "$schema": "./node_modules/turbo/schema.json",
  "concurrency": "2",
  "globalDependencies": [
    "package.json",
    "pnpm-workspace.yaml",
    ".nvmrc"
  ],
  "globalPassThroughEnv": [
    "VITEST_MAX_WORKERS",
    "VITEST_MAX_FORKS",
    "VITEST_MAX_THREADS",
    "VITEST_MIN_FORKS",
    "VITEST_MIN_THREADS",
    "FEATURE_LINT_BASE"
  ],
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "transit"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/components.json",
        "$TURBO_ROOT$/apps/platform-web/src/style.css",
        "$TURBO_ROOT$/tooling/eslint/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/eqv/*/package.json",
        "$TURBO_ROOT$/packages/sdk/*/package.json",
        "$TURBO_ROOT$/packages/adapters/*/package.json",
        "$TURBO_ROOT$/menus/*/*/package.json",
        "$TURBO_ROOT$/platform/*/package.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "transit"
      ]
    },
    "build": {
      "dependsOn": [
        "transit",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tooling/sdk/sdk-finalize-dist.mjs"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@ap/platform-api-ops#lint": {
      "cache": false
    },
    "@ap/platform-api#typecheck": {
      "dependsOn": [
        "transit",
        "@ap/contract-schemas#build"
      ]
    },
    "@ap/platform-api#test": {
      "dependsOn": [
        "transit",
        "@ap/contract-schemas#build"
      ]
    },
    "@eqv/core#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eqv/assets/**",
        "$TURBO_ROOT$/packages/eqv/fixtures/**"
      ]
    },
    "@eqv/renderer#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eqv/assets/**",
        "$TURBO_ROOT$/packages/eqv/fixtures/**"
      ]
    },
    "@eqv/replay#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eqv/fixtures/**"
      ]
    },
    "@eqv/views#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eqv/fixtures/**"
      ]
    },
    "@eqv/editor#typecheck": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eqv/assets/templates/**"
      ]
    },
    "@eqv/editor#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eqv/assets/**",
        "$TURBO_ROOT$/packages/eqv/fixtures/**"
      ]
    },
    "@ap/menu-topview-studio#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eqv/assets/**"
      ]
    },
    "@ap/menu-topview#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eqv/fixtures/**",
        "$TURBO_ROOT$/menus/log-dev/log-knowledge/src/mock/**",
        "$TURBO_ROOT$/menus/tools/topview-studio/src/mock/**"
      ]
    }
  }
}
