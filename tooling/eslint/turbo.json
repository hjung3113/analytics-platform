{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/tsconfig*.json",
        "$TURBO_ROOT$/packages/sdk/*/package.json",
        "$TURBO_ROOT$/packages/sdk/*/tsconfig*.json",
        "$TURBO_ROOT$/packages/adapters/*/package.json",
        "$TURBO_ROOT$/packages/adapters/*/tsconfig*.json",
        "$TURBO_ROOT$/packages/sdk/shell/src/__fixtures__/**",
        "$TURBO_ROOT$/menus/*/*/package.json",
        "$TURBO_ROOT$/menus/*/*/tsconfig*.json",
        "$TURBO_ROOT$/platform/*/package.json",
        "$TURBO_ROOT$/platform/*/tsconfig*.json",
        "$TURBO_ROOT$/apps/platform-web/tsconfig*.json",
        "$TURBO_ROOT$/menus/*/*/eslint.config.js",
        "$TURBO_ROOT$/platform/*/eslint.config.js",
        "$TURBO_ROOT$/apps/platform-api/package.json",
        "$TURBO_ROOT$/apps/platform-api/eslint.config.js",
        "$TURBO_ROOT$/apps/feature-screens/package.json",
        "$TURBO_ROOT$/apps/feature-screens/eslint.config.js",
        "$TURBO_ROOT$/components.json",
        "$TURBO_ROOT$/apps/platform-web/src/**/*.css",
        "$TURBO_ROOT$/apps/feature-screens/*.css",
        "$TURBO_ROOT$/packages/**/*.css",
        "$TURBO_ROOT$/menus/**/*.css",
        "$TURBO_ROOT$/platform/**/*.css",
        "$TURBO_ROOT$/packages/sdk/ui/src/components/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/dist/**"
      ]
    },
    "transit": {
      "inputs": ["package.json"]
    }
  }
}
