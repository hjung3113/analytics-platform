+  const conditions = [lastParams?.get('scopeId') ?? global.scopeId,
+    lastParams?.get('from') || lastParams?.get('to') ? formatPeriod(lastParams.get('from'), lastParams.get('to'), lang) : null,
+  ].filter(Boolean).join(' · ');
+  const taskColumn = <div className="min-w-0 space-y-4 [&_section]:border-0 [&_section]:bg-transparent [&_section]:p-0">{todo}</div>;
+  const groups = new Map<string, MenuEntry[]>();
+  for (const menu of menus) {
+    if (![menu.label.ko, menu.label.en, draftOf(menu)?.sourceLabel, registry.spaceOf(menu)?.label.ko, registry.groupById(menu.group).label.ko].some(label => label?.toLowerCase().includes(query.toLowerCase()))) continue;
+    const draft = draftOf(menu);
+    const label = (merged || grouping === 'stage') && draft ? draft.stageLabel : tx(registry.spaceOf(menu)?.label ?? registry.groupById(menu.group).label);
