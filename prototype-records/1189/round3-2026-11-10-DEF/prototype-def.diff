+  const { variant } = prototype1189();
+  const { setSwitcherOpen, navigate, pathname } = useHostPlatform();
+  const { switcherOpen: open, switcherSession: session } = useOverlayState();
+  const trigger = useRef<HTMLButtonElement>(null);
+  const body = useRef<HTMLDivElement>(null);
+  const owner = useRef(Symbol('prototype1189q'));
+  const pending = useRef<string | null>(null);
+  const openedAt = useRef(pathname);
