+  const analysis = menus.filter(menu => draftOf(menu));
+  const stageGroups = [...new Map(analysis.map(menu => [draftOf(menu)!.stage, draftOf(menu)!.stageLabel])).entries()].sort(([a], [b]) => a - b);
+  const name = (menu: MenuEntry) => merged && draftOf(menu)?.mergedLabel ? draftOf(menu)!.mergedLabel! : tx(menu.label);
+  const row = (menu: MenuEntry) => <PlatformLink key={menu.id} href={homePrototypeHref(linkTo(menu.id))} className={cn(navRowVariants(), 'justify-between break-keep')}><span>{name(menu)}</span>{!merged && (variant !== 'E' || grouping === 'stage') && draftOf(menu) && registry.spaceOf(menu) && <span className="ml-auto shrink-0 text-caption font-normal text-text-muted">{tx(registry.spaceOf(menu)!.label)}</span>}</PlatformLink>;
+  const favorites = <section aria-label={t('favorites')}><h2 className="mb-3 flex items-center gap-2 t-card-title"><Star className="size-4 text-accent-warn" aria-hidden />{t('favorites')}</h2>{favoriteBody}</section>;
+  const recents = <section aria-label={t('recent')}><h2 className="mb-3 flex items-center gap-2 t-card-title"><Clock3 className="size-4 text-text-muted" aria-hidden />{t('recent')}</h2>{recentBody}</section>;
+  const last = recent.find(row => row.menuId !== registry.platformHome?.id && registry.menus.some(menu => menu.id === row.menuId && canOpen(menu.id)));
+  const lead = last && registry.menuById(last.menuId);
