+  const matches = menus.filter(menu => [menu.label.ko, menu.label.en, draft1189(menu)?.sourceLabel, registry.spaceOf(menu)?.label.ko, registry.spaceOf(menu)?.label.en, registry.groupById(menu.group).label.ko].some(label => label?.toLowerCase().includes(query.toLowerCase())));
+  return <div className="p-3 break-keep">{search && <SearchInput className="mb-4 w-full" aria-label="이동할 메뉴 검색" placeholder="메뉴 검색" value={query} onValueChange={setQuery} />}
