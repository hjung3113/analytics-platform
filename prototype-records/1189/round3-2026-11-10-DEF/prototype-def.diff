+        <div className="grid grid-cols-4 gap-8"><div className="space-y-6 border-r border-border-subtle pr-6">{taskColumn}{notices}{favorites}{recents}</div><nav aria-label="전체 메뉴" className="col-span-3 space-y-6">{[true, false].map(analysis => <section key={String(analysis)}><h2 className={analysis ? 'mb-3 px-3 t-section-title' : 'mb-3 border-t border-border-subtle px-3 pt-4 t-card-title'}>{analysis ? '분석' : '다른 목적지'}</h2><div className="grid grid-cols-4 gap-5">{columns(analysis).map((column, index) => <div key={index} className="space-y-5">{column.map(([label, items]) => <section key={label}><h3 className="mb-2 px-3 t-card-title">{label}</h3>{items.map(row)}</section>)}</div>)}</div></section>)}{groups.size === 0 && <p className="text-sm text-text-secondary">검색 결과가 없습니다</p>}</nav></div>
+      </section>
+    </>}
+
+    {variant === 'F' && <div className="mx-auto max-w-5xl space-y-8 py-4">
+      <section aria-label="이어서 작업"><h2 className="mb-4 t-section-title">이어서 작업</h2>{lead && last ? <PlatformLink href={homePrototypeHref(last.url)} className="group flex items-center justify-between gap-6 border-y border-border-subtle py-8 hover:text-accent-primary focus-visible:ring-2 focus-visible:ring-focus-ring"><span><span className="mb-2 block text-xs text-text-secondary">{!merged && registry.spaceOf(lead) ? `${tx(registry.spaceOf(lead)!.label)} · ` : ''}최근 방문</span><span className="block t-page-title">{name(lead)}</span><span className="mt-3 block text-sm text-text-secondary">{conditions || '전체'}</span></span><ArrowRight className="size-6 text-accent-primary" aria-hidden /></PlatformLink> : <div className="border-y border-border-subtle py-8"><p className="text-sm text-text-secondary">{t('noRecent')}</p><p className="mt-2 text-xs text-text-muted">이동에서 메뉴를 찾아 시작하세요.</p></div>}</section>
+      <div className="grid grid-cols-3 gap-8">{favorites}{recents}{taskColumn}</div>{notices}
+    </div>}
+  </div>;
+}
