+// #1189q private, throwaway presentation. Stage mapping is supplied by the app.
+import { useState, type ReactNode } from 'react';
+import { ArrowRight, Clock3, Star } from 'lucide-react';
+import { PlatformLink, useI18n, usePlatform, useRecentVisits, type MenuEntry } from '@ap/kernel';
+import { formatPeriod } from '@ap/contracts';
+import { SegmentedRadio } from '@ap/components';
+import { cn, navRowVariants, SearchInput } from '@ap/ui';
+
+type Draft = { stage: number; stageLabel: string; source: string | null; mergedLabel?: string; sourceLabel?: string };
+const draftOf = (menu: MenuEntry) => (menu as MenuEntry & { prototype1189?: Draft }).prototype1189;
+export function homePrototype() {
+  const params = new URLSearchParams(window.location.search);
+  const value = params.get('variant');
+  return { variant: value === 'D' || value === 'E' || value === 'F' ? value : null, merged: params.get('merged') === '1' };
+}
+export function homePrototypeHref(href: string) {
+  const { variant, merged } = homePrototype();
+  if (!variant) return href;
+  const url = new URL(href, window.location.origin);
+  url.searchParams.set('variant', variant);
+  if (merged) url.searchParams.set('merged', '1');
+  return url.pathname + url.search + url.hash;
+}
+
+export function HomePrototype({ favoriteBody, recentBody, todo, notices, zeroState }: { favoriteBody: ReactNode; recentBody: ReactNode; todo: ReactNode; notices: ReactNode; zeroState: ReactNode }) {
+  const { registry, canOpen, linkTo, accessibleSpaces, spaceEntry, global } = usePlatform();
