+    })}</section>)}</nav>
+  </aside></TooltipProvider>;
+}
+
+export function PrototypeTopbar() {
+  return <div className="flex h-[50px] shrink-0 items-center gap-8 border-b border-border-subtle bg-surface-sidebar px-4 break-keep"><span className="text-sm font-semibold">i-MAP</span><PrototypeNavigation /></div>;
+}
