+export function prototype1189() {
+  const params = new URLSearchParams(window.location.search);
+  const value = params.get('variant');
+  return { variant: value === 'D' || value === 'E' || value === 'F' ? value : null, merged: params.get('merged') === '1' };
+}
+export function prototypeHref(href: string) {
+  const { variant, merged } = prototype1189();
+  if (!variant) return href;
+  const url = new URL(href, window.location.origin);
+  url.searchParams.set('variant', variant);
+  if (merged) url.searchParams.set('merged', '1');
+  return url.pathname + url.search + url.hash;
+}
+
+export function PrototypeHomeLink() {
+  const { registry, linkTo, canOpen } = useHostPlatform();
+  const home = registry.platformHome;
+  return home && canOpen(home.id) ? <Tooltip><TooltipTrigger asChild><PlatformLink aria-label="플랫폼 홈" href={prototypeHref(linkTo(home.id))} className="my-2 grid size-8 place-items-center rounded-md text-accent-primary hover:bg-surface-row-hover focus-visible:ring-2 focus-visible:ring-focus-ring"><Home className="size-4" aria-hidden /></PlatformLink></TooltipTrigger><TooltipContent side="right">홈</TooltipContent></Tooltip> : null;
+}
+
+/** Shared focus session follows the existing switcher, including deferred selection after trap teardown. */
