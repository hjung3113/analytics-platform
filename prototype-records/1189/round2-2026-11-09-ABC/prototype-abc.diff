+import { createContext } from 'react';
+
+/** #1189 throwaway only. No public barrel export or persisted setting. */
+export const PrototypeHeadSwitcher = createContext(false);
+export function homePrototypeVariant() {
+  const value = new URLSearchParams(window.location.search).get('variant');
+  return value === 'A' || value === 'B' || value === 'C' ? value : null;
+}
+export function prototype1189Href(href: string) {
+  const variant = homePrototypeVariant();
+  if (!variant) return href;
+  const url = new URL(href, window.location.origin);
+  url.searchParams.set('variant', variant);
+  return url.pathname + url.search + url.hash;
+}
