# FeedbackOps (713p2): products/feedbackops/.gitignore의 경로 고정 항목 (앱이 apps/fo-*로 이동)
# TanStack Router generated route tree
# Pre-bundled Drizzle schema consumed by drizzle-kit (apps/platform-api/scripts/bundle-schema.mjs)
apps/platform-api/.drizzle-schema/
# Unanchored entries of the old file, kept at every depth under the feature apps and packages (the platform has its own rules)
apps/platform-api/**/.vite
packages/feature/screens/**/.vite
apps/platform-api/**/report/
packages/feature/screens/**/report/
apps/platform-api/**/coverage
packages/feature/screens/**/coverage
apps/platform-api/**/build
packages/feature/screens/**/build
apps/platform-api/**/*.log
packages/feature/screens/**/*.log
apps/platform-api/**/smoke-*.png
packages/feature/screens/**/smoke-*.png
apps/platform-api/**/visual-*.png
packages/feature/screens/**/visual-*.png
packages/feature/shared/**/.vite
packages/feature/shared/**/report/
packages/feature/shared/**/coverage
packages/feature/shared/**/build
packages/feature/shared/**/*.log
# The bridge entry `@ap/feature-screens/operator-screens/coverage` (#762 c) is source, not a test-coverage report.
!packages/feature/screens/src/operator-screens/coverage/
# .env files of the old file, at every depth under the feature apps and packages (.env.example stays tracked)
apps/platform-api/**/.env
packages/feature/screens/**/.env
apps/platform-api/**/.env.local
packages/feature/screens/**/.env.local
apps/platform-api/**/.env.*.local
packages/feature/screens/**/.env.*.local
apps/platform-api/**/.env.release
packages/feature/screens/**/.env.release
packages/feature/shared/**/.env
packages/feature/shared/**/.env.local
packages/feature/shared/**/.env.*.local
packages/feature/shared/**/.env.release

# Local documentation scratch (no existing local data is moved).
docs/.llmwiki/

# Any .env anywhere (examples stay tracked)
**/.env
!**/.env.example
/*.log
