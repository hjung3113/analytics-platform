{
  "name": "@ap/platform-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build:schemas": "pnpm --filter @ap/contract-schemas run build",
    "dev": "pnpm run build:schemas && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "pnpm run build:schemas && env -u DATABASE_URL -u DATABASE_URL_MIGRATE -u WORKSPACE_ID ALLOW_SKIPPED_INTEGRATION=1 vitest run",
    "test:integration": "pnpm run build:schemas && bash ../../ops/platform-api/scripts/test-integration.sh",
    "jobs:inventory": "tsx src/cli/jobs-inventory.ts",
    "jobs:health": "tsx src/cli/jobs-health.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.platform-tests.json",
    "gen:bundled-templates": "node scripts/gen-bundled-templates.mjs",
    "db:generate": "node scripts/bundle-schema.mjs && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx src/seed/index.ts",
    "search:eval": "tsx --env-file=${PLATFORM_API_ENV_FILE:?set PLATFORM_API_ENV_FILE to the throwaway database env file} src/modules/log-knowledge/__tests__/search-eval/run-eval.ts",
    "search:load": "tsx --env-file=${PLATFORM_API_ENV_FILE:?set PLATFORM_API_ENV_FILE to the throwaway database env file} src/modules/log-knowledge/__tests__/search-eval/run-load.ts"
  },
  "dependencies": {
    "@ap/contract-schemas": "workspace:*",
    "@ap/feature-shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/lib-storage": "^3.1167.0",
    "@eqv/core": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "10.3.0",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "4.0.2",
    "jszip": "3.10.2",
    "mssql": "12.7.14",
    "nodemailer": "^10.5.0",
    "openid-client": "^6.8.9",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "9.14.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@ap/contracts": "workspace:*",
    "@ap/eslint-config": "workspace:*",
    "@ap/http-adapter": "workspace:*",
    "@ap/server-conformance": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "form-data": "^4.0.1",
    "jose": "^6.2.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
