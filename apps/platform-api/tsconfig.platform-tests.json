{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/types/*.d.ts",
    "src/modules/platform-port/__tests__/platform-conformance.integration.test.ts",
    "src/modules/platform-saved-views/__tests__/transition-drift.test.ts",
    "src/modules/log-knowledge/__tests__/catalog-menu-drift.test.ts",
    "src/modules/improvement-items/__tests__/item-input.test.ts",
    "src/modules/log-lifecycle/__tests__/request-queue.integration.test.ts"
  ],
  "exclude": []
}
