{
  "name": "@ap/platform-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:base-path": "playwright test --config playwright.base-path.config.ts",
    "e2e:real": "playwright test --config playwright.real.config.ts && playwright test --config playwright.real-down.config.ts",
    "e2e:merge": "playwright merge-reports --config playwright.merge.config.ts ./blob-report",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@ap/eslint-config": "workspace:*",
    "@ap/platform-web": "workspace:*",
    "@ap/tsconfig": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3"
  }
}
