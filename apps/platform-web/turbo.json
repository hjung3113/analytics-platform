{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "test": {
      "env": ["GEN_MENU_PROBE"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/sdk/ui/src/rich-content/**",
        "../../packages/feature/shared/src/rich-content/**",
        "$TURBO_ROOT$/packages/*/*/src/**",
        "$TURBO_ROOT$/packages/*/*/package.json",
        "$TURBO_ROOT$/packages/eqv/assets/observations/**",
        "$TURBO_ROOT$/apps/platform-api/src/server.ts",
        "$TURBO_ROOT$/apps/platform-api/src/modules/**"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tooling/sdk/sdk-finalize-dist.mjs",
        "$TURBO_ROOT$/packages/feature/screens/src/**",
        "$TURBO_ROOT$/packages/feature/screens/package.json",
        "$TURBO_ROOT$/packages/feature/shared/src/**",
        "$TURBO_ROOT$/packages/feature/screens/src/ui/**"
      ],
      "env": [
        "AP_BACKEND_ORIGIN",
        "AP_BASE_PATH",
        "AP_PLATFORM_ASSEMBLY"
      ]
    }
  }
}
