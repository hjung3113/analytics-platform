{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "test": {
      "env": ["GEN_MENU_PROBE"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/sdk/ui/src/rich-content/**",
        "../../packages/feature-shared/src/rich-content/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/sdk/*/src/**",
        "$TURBO_ROOT$/packages/sdk/*/package.json",
        "$TURBO_ROOT$/packages/adapters/*/src/**",
        "$TURBO_ROOT$/packages/adapters/*/package.json"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tooling/sdk/sdk-finalize-dist.mjs",
        "$TURBO_ROOT$/apps/feature-screens/src/**",
        "$TURBO_ROOT$/apps/feature-screens/package.json",
        "$TURBO_ROOT$/packages/feature-shared/src/**",
        "$TURBO_ROOT$/packages/feature-ui/src/**"
      ],
      "env": [
        "AP_BACKEND_ORIGIN",
        "AP_BASE_PATH",
        "AP_PLATFORM_ASSEMBLY"
      ]
    }
  }
}
