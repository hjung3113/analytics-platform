# Local-only values for docker-compose.release.yml. Never use them in a deployment.
POSTGRES_PASSWORD=local-release-postgres-superuser
OIDC_CLIENT_SECRET=local-release-oidc-client-secret
WORKSPACE_ID=00000000-0000-4000-8000-000000001060
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-local-only
# MinIO server image, set per site (#1617); the repo pins none. In-house value: bitnami/minio:2024.7.16-debian-12-r0.
# Public copy of the same image for a local run: bitnamilegacy/minio:2024.7.16-debian-12-r0.
MINIO_IMAGE=CHANGE_ME
STORAGE_S3_BUCKET=platform-attachments

# Required retained platform host callback; that host forwards /auth to the backend.
# Use its actual absolute URL ending in /auth/callback (no guessed backend port).
OIDC_REDIRECT_URI=
