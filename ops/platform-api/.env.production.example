# Template for docker-compose.production.yml. Copy to .env.production (gitignored) and replace EVERY CHANGE_ME.
# scripts/release/production-preflight.sh .env.production must exit 0 before `up`.
# Never reuse values from .env.release.example (local smoke demo values; the preflight rejects them).

# Secrets (generate long random values; never commit real ones).
POSTGRES_PASSWORD=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
# MinIO server image, set per site (#1617); the repo pins none. In-house value: bitnami/minio:2024.7.16-debian-12-r0.
MINIO_IMAGE=CHANGE_ME
# DB login-role passwords: ^[A-Za-z0-9_-]{24,}$, different from each other (openssl rand -hex 24). Applied by the
# set-role-passwords job; keep this file mode 0600.
PLATFORM_APP_DB_PASSWORD=CHANGE_ME
PLATFORM_MIGRATE_DB_PASSWORD=CHANGE_ME

# Single Workspace UUID (FO ADR-0006). Pick once; never change it for an existing install.
WORKSPACE_ID=CHANGE_ME
WORKSPACE_NAME=Platform
# Optional. Path (inside the backend container) of the business-system declaration the startup sync reads. Leave unset:
# the image ships its own copy at /app/platform-systems.json. Empty is treated as unset.
# PLATFORM_SYSTEMS_FILE=/app/platform-systems.json
STORAGE_S3_BUCKET=platform-attachments

# Real IdP. Issuer and redirect must be https; the redirect path is exactly /auth/callback.
OIDC_ISSUER_URL=https://CHANGE_ME
OIDC_CLIENT_ID=CHANGE_ME
OIDC_REDIRECT_URI=https://CHANGE_ME/auth/callback
OIDC_SCOPES=openid email profile

# Trusted proxy hops in front of the backend. Topology: company TLS ingress -> edge (nginx) -> backend = 2.
# The ingress must set X-Forwarded-Proto and append to X-Forwarded-For (never pass client values through).
TRUSTED_PROXY_HOPS=2

# Only the edge is published. EDGE_BIND has no default: set the interface only the company ingress reaches, and allow
# only the ingress to reach EDGE_PORT in the host firewall / security group. 0.0.0.0 is refused by the preflight unless
# EDGE_BIND_ALL_INTERFACES_ACK=yes is also set.
EDGE_BIND=CHANGE_ME
EDGE_PORT=8080

# Notification email. NOTIFICATION_EMAIL_CHANNEL has no default: set mock (email disabled, notifications reach the
# inbox only) or smtp. With smtp, SMTP_HOST, SMTP_PORT (positive integer) and SMTP_FROM are required; SMTP_USERNAME
# and SMTP_PASSWORD are set together or both left blank.
NOTIFICATION_EMAIL_CHANNEL=CHANGE_ME
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional budgets (defaults shown; see .env.example).
# DB_POOL_MAX=10
# DB_POOL_ACQUIRE_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_LOCK_TIMEOUT_MS=5000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# HTTP_REQUEST_TIMEOUT_MS=30000
