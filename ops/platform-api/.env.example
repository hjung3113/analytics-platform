# Platform API environment template. Copy to `.env` and fill in.
# Real `.env*` files are gitignored.

# --- Server runtime ---
# 'development' | 'test' | 'production'. Defaults to 'development'.
NODE_ENV=development
# Backend HTTP port. Vite dev proxy expects 3011 (see vite.config.ts).
PORT=3011
# Bind host for Fastify. 0.0.0.0 listens on all interfaces (dev/docker).
HOST=0.0.0.0
# FO ADR-0006: single seeded workspace. UUID of the dev workspace (matches seed CLI output).
WORKSPACE_ID=00000000-0000-0000-0000-000000000001
# Display name for the seeded workspace.
WORKSPACE_NAME=Platform
# 'mock' = local dev session shim; 'oidc' = real provider.
AUTH_PROVIDER=mock
# Slice 1 seed scope. Only 'core' is supported today.
SEED_MODE=core
# #1289 node i: business-system declaration the startup sync reads (apps/platform-web/platform-systems.json).
# Empty or unset: only the platform system is ensured. In the backend image it defaults to /app/platform-systems.json.
PLATFORM_SYSTEMS_FILE=

# --- OIDC (required when AUTH_PROVIDER=oidc, ignored otherwise) ---
# Real IdP configuration (FO ADR-0006, amended 2026-09-22 / issue #390).
# All four OIDC_* variables below are REQUIRED when AUTH_PROVIDER=oidc;
# config load fails before boot when any is missing or inconsistent.
# NEVER commit a real secret here.
# Issuer identifier of the IdP. Absolute https URL, no query/fragment/
# credentials. Plain http is allowed only for http://localhost[:port] or
# http://127.0.0.1[:port] and only outside production.
OIDC_ISSUER_URL=
# OAuth client id at the IdP (non-empty).
OIDC_CLIENT_ID=
# OAuth client secret at the IdP (non-empty). Never commit a real value.
OIDC_CLIENT_SECRET=
# Where the IdP sends the browser after login. Absolute URL whose path is
# EXACTLY /auth/callback, no fragment; https in production (http localhost /
# 127.0.0.1 allowed outside production).
OIDC_REDIRECT_URI=http://localhost:3011/auth/callback
# Space-separated scopes. Must include 'openid'. Default below.
OIDC_SCOPES="openid email profile"

# --- Keycloak (local, profile auth) ---
# docker compose -f docker-compose.dev.yml --profile auth up -d   (Keycloak :8085, Mailpit UI :8025)
# To log in through the local Keycloak, set these instead of AUTH_PROVIDER=mock above:
# AUTH_PROVIDER=oidc
# OIDC_ISSUER_URL=http://localhost:8085/realms/platform
# OIDC_CLIENT_ID=platform
# OIDC_CLIENT_SECRET=local-dev-secret
# OIDC_REDIRECT_URI=http://localhost:3011/auth/callback
# Runbook: ops/platform-api/docs/release/keycloak-interim-idp.md

# CSP `img-src`/`connect-src` origin for public attachment URLs. Accepted:
# the quoted literal `'self'` (default; keeps everything same-origin) or a
# bare origin `https://host[:port]` — no path, query, credentials, or
# wildcards. Outside production, `http://localhost[:port]` and
# `http://127.0.0.1[:port]` are also accepted. Anything else fails config
# load (#402).
PUBLIC_ATTACHMENT_ORIGIN="'self'"
# Number of trusted proxy hops in front of Fastify (X-Forwarded-For chain
# depth). 0 outside production = trust nothing. Set to 1 in prod when a
# single ingress terminates TLS. See Review HTTP-H-2 / FO ADR-0015.
TRUSTED_PROXY_HOPS=0

# --- Embeddings (FO ADR-0034 D2) ---
# 'disabled' (default), 'fake' for deterministic offline tests, or 'voyage'.
# Explicit paid draft preview admission; saved ingestion is independent.
VOC_SIMILARITY_PREVIEW=enabled
EMBEDDING_PROVIDER=disabled
# Required when EMBEDDING_PROVIDER=voyage. Never commit a real key.
EMBEDDING_API_KEY=
# Increment when changing model/version so stored vectors are re-embedded.
EMBEDDING_VERSION=1

# --- DB time budgets and HTTP request timeout (#1266 b3) ---
# Runtime app pool only; migrate/seed/test pools keep server defaults. All positive integers.
# Max connections in the runtime app pool.
DB_POOL_MAX=10
# How long a request waits for a free pool connection before it fails with 503.
DB_POOL_ACQUIRE_TIMEOUT_MS=5000
# Postgres statement_timeout for runtime sessions (SQLSTATE 57014 -> 503).
DB_STATEMENT_TIMEOUT_MS=15000
# Postgres lock_timeout for runtime sessions (SQLSTATE 55P03 -> 503).
DB_LOCK_TIMEOUT_MS=5000
# Postgres idle_in_transaction_session_timeout for runtime sessions (SQLSTATE 25P03).
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# Fastify requestTimeout: time allowed to receive a complete request.
HTTP_REQUEST_TIMEOUT_MS=30000

# Operator maintenance only, never for a serving stack: true starts pg-boss without the supervisor and cron scheduler and
# registers no job worker (pending jobs are neither run nor stamped). restore.sh sets it for its verification backend.
JOBS_DISABLED=false

# --- Notification email (FO ADR-0014, Issue #509 part 3) ---
# 'mock' keeps local development and CI from sending mail; use 'smtp' for the company relay.
NOTIFICATION_EMAIL_CHANNEL=mock
# Required when NOTIFICATION_EMAIL_CHANNEL=smtp. Username and password must be set together or both left blank.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Postgres (matches docker-compose.dev.yml :5434) ---
DATABASE_URL=postgres://platform_app:platform_app@localhost:5434/platform
DATABASE_URL_MIGRATE=postgres://platform_migrate:platform_migrate@localhost:5434/platform

# --- Attachment storage (S3-compatible, MinIO in dev/prod per FO ADR-0011 amendment) ---
# Swap endpoint/region/credentials to point at AWS S3 or Cloudflare R2 in prod.
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=platform-attachments
STORAGE_S3_ACCESS_KEY_ID=platform-minio
STORAGE_S3_SECRET_ACCESS_KEY=platform-minio-secret-change-me
STORAGE_S3_FORCE_PATH_STYLE=true
# Object-store deadlines (ms): a stalled put/get fails as storage.unavailable.
STORAGE_S3_REQUEST_TIMEOUT_MS=30000
STORAGE_S3_CONNECT_TIMEOUT_MS=5000
# Concurrent POST /attachments per process (each buffers up to 25 MiB); the
# next one gets 503 service.unavailable with Retry-After: 5.
ATTACHMENT_UPLOAD_CONCURRENCY=4

# --- API tokens (FO ADR-0116) ---
# Optional. Days without use before a token is flagged "unused" in the token list (default 30).
API_TOKEN_UNUSED_WARNING_DAYS=30
